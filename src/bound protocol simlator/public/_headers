# Cloudflare Pages response headers.
#
# Access control itself is enforced by the Access policies in front of the paths —
# see DEPLOYMENT.md. These headers are defence in depth, not the gate.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()

# Confidential material must never be cached by an intermediary, and must never be
# indexed if a policy is ever misconfigured.
/legal/*
  Cache-Control: private, no-store, max-age=0
  X-Robots-Tag: noindex, nofollow, noarchive

# The gated documents are equally not for indexing.
